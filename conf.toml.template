[Mysql]
Db = "Yearning_go"
Host = "127.0.0.1"
Port = "3306"
Password = "xxxxxxx"
User = "root"

[General]
# SecretKey 是 JWT 签名与数据源口令加密的主密钥，一旦泄露等同于交出全部数据库凭据。
# 必须替换为随机字符串（建议 32 字符以上），不要使用模板中的示例值，也不要提交到仓库。
# 生成方式：openssl rand -base64 32 （或用环境变量 SECRET_KEY 注入）
SecretKey = "CHANGE_ME_PLEASE_USE_RANDOM_32_CHARS"
RpcAddr = "127.0.0.1:50001" # SQL checker rpc server address
# 审核引擎 gRPC 的共享访问令牌：须与引擎启动参数一致
# （引擎 -auth-token 或环境变量 ENGINE_AUTH_TOKEN）。两侧都留空 = 不启用认证
# （仅限引擎完全隔离在可信内网）；跨网络/共享内网部署必须启用。
# 生成方式：openssl rand -base64 32
RpcToken = ""
# 单实例互斥（默认开启）：同一元数据库只允许一个 Yearning 主实例运行，
# 基于 MySQL GET_LOCK（实例崩溃锁自动释放；第二个实例启动直接失败）。
# cron 统计、OSC 中止、执行超时自愈都依赖它。仅特殊部署才应置 true 关闭。
DisableInstanceLock = false
# 单工单引擎执行超时（分钟），默认 5。0 = 不限制。
# 大批量 DML / 未走 OSC 的大 DDL 可能需要更久——被超时切断的 DDL 回滚代价很高。
ExecTimeoutMinutes = 5
# 执行中(status=3)工单的僵尸自愈阈值（小时），默认 6：进程异常重启会留下永远
# 「执行中」的工单，超过阈值自动置为失败并留痕，可再用重试/跳过接管。
# 正在运行的 gh-ost 自动豁免。0 = 关闭自愈。依赖单实例互斥开启。
SelfHealHours = 6
LogLevel = "info"  # debug,info,warn,error
Lang = "en_US"  # en_US,zh_CN

# 在线表结构变更(OSC)：表行数估算 >= OscMinRows 的大表 ALTER 改由 gh-ost 执行，
# 迁移进度实时显示在工单详情的「OSC」面板。OscMinRows <= 0 表示关闭（走引擎原生执行）。
OscMinRows = 0
# gh-ost 可执行文件路径；留空则从 PATH 中查找 gh-ost
GhOstPath = ""
# gh-ost 附加参数（空格分隔），按环境补充。例如数据源账号无 performance_schema 权限时：
#   GhOstArgs = "--skip-metadata-lock-check"
GhOstArgs = ""

