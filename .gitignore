# ===== 本地运行时配置 / 密钥 =====
conf.toml

# ===== Go 构建产物 =====
Yearning
Yearning.exe
*.exe
*.test
*.out
juno

# ===== Go 临时/测试目录 =====
.tmpgotest/

# ===== 打包 / 安装 / 迁移临时产物 =====
*.egg-info/
*.egg

# ===== 前端 embed 产物 =====
# 说明：
#   - 前端源码在本仓库 front/，构建产物由 front 编译产出（vite 默认 outDir=front/dist）。
#   - 后端经 go:embed 内嵌前端，产物需位于 src/service/dist/（go:embed 无法引用上级目录），
#     因此 front 构建完成后需将产物放入 src/service/dist/（见 docs/DEVELOPMENT.md 第 3 节）。
#   - engine/ 与 front/ 为纳入版本控制的源码目录，产物不入库，交由各自子 .gitignore 处理。
src/service/dist/
src/service/chat/*

# ===== 编辑器 / IDE =====
.idea/
.vscode/
*.iml

# ===== 日志 =====
*.log

# ===== 环境 / 缓存 =====
.env
.venv/
.cache/
