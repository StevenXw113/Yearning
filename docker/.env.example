# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env（.env 已被 .gitignore 忽略）

# 镜像：均由 `docker compose build` 源码构建，不要填官方镜像；多机部署改成私有仓库地址
FRONTEND_IMAGE=yearning-frontend:local
YEARNING_IMAGE=yearning:local
ENGINE_IMAGE=yearning-engine:local

# 主密钥（必改）：openssl rand -base64 32；投产后不要更换，否则数据源口令无法解密
SECRET_KEY=请替换为随机串

# MySQL（必改口令）
MYSQL_ROOT_PASSWORD=请替换为强口令
MYSQL_USER=yearning
MYSQL_PASSWORD=请替换为强口令
MYSQL_DB=Yearning_go

Y_LANG=zh_CN
TZ=Asia/Shanghai

# 审核引擎共享令牌：留空 = 不认证（引擎仅容器内网可达时可用）；跨网络部署建议生成随机串
RPC_TOKEN=

# 前端入口 http://<服务器IP>:8000；前置 HTTPS 时改 FRONT_BIND_ADDR=127.0.0.1
FRONT_BIND_ADDR=0.0.0.0
FRONT_PORT=8000

# 构建依赖源（默认国内，一般不用改）
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY_URL=https://goproxy.cn,direct
